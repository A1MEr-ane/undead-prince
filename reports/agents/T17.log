        for x, z in ((0, -width), (.019, 0), (0, width), (-.019, 0)):
            verts.append(tuple(m @ V((x, longitudinal, z))))
    faces, uvs = [], []
    for j in range(2):
        for i in range(4):
            faces.append((j * 4 + (i + 1) % 4, j * 4 + i,
